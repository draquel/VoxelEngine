#include "/Engine/Private/Common.ush"

uint  VertsPerSide;
float TileSizeWS;
float VertexSpacingWS;
float _Pad0;
float3 TileOriginWS;
uint  NoiseIndex;

// Matches your vertex buffer layout: float4(posWS, 0)
Buffer<float4> InPositions;

// Output normals: float4(n,0)
RWBuffer<float4> OutNormals;

uint VertexIndex(uint x, uint y) { return y * VertsPerSide + x; }

float3 LoadPos(uint x, uint y)
{
	return InPositions[VertexIndex(x, y)].xyz;
}

[numthreads(8,8,1)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
	uint x = DTid.x;
	uint y = DTid.y;
	if (x >= VertsPerSide || y >= VertsPerSide) return;

	// Clamp neighbor coordinates at borders (stable)
	uint xm = (x > 0) ? (x - 1) : x;
	uint xp = (x + 1 < VertsPerSide) ? (x + 1) : x;

	uint ym = (y > 0) ? (y - 1) : y;
	uint yp = (y + 1 < VertsPerSide) ? (y + 1) : y;

	float3 pL = LoadPos(xm, y);
	float3 pR = LoadPos(xp, y);
	float3 pD = LoadPos(x, ym);
	float3 pU = LoadPos(x, yp);

	// Tangent directions in world space
	float3 dX = pR - pL;
	float3 dY = pU - pD;

	// Choose cross order to match your CCW winding.
	float3 n = cross(dX, dY);

	float len2 = dot(n, n);
	n = (len2 > 1e-20f) ? n * rsqrt(len2) : float3(0, 0, 1);

	OutNormals[VertexIndex(x, y)] = float4(n, 0);
}
