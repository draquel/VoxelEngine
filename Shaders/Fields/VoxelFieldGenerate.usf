// /Plugin/Voxel/Fields/VoxelFieldGenerate.usf

#include "/Engine/Private/Common.ush"
#include "../Noise/VoxelDensity.ush"

float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
uint   SamplesPerAxis;
float  IsoLevel;
uint   ChunkSeed;

StructuredBuffer<FVoxelNoiseParams> NoiseParamsBuf;

float2 BiomeTempMoistureFreq;
float2 BiomeTempOffset;
float2 BiomeMoistureOffset;
float2 BiomeTempMoistureHeightInfluence;
float  BiomeDomainWarpFrequency;
float  BiomeDomainWarpAmplitude;
float  BiomeSeaLevel;
float  BiomeColdTemperature;
float  BiomeHotTemperature;
float  BiomeDryMoisture;
float  BiomeWetMoisture;
uint   BiomeSeed;

uint   DesertSurfaceMaterialId;
uint   DesertSubsurfaceMaterialId;
uint   DesertDeepMaterialId;
float2 DesertSubsurfaceZRange;

uint   PlainsSurfaceMaterialId;
uint   PlainsSubsurfaceMaterialId;
uint   PlainsDeepMaterialId;
float2 PlainsSubsurfaceZRange;

uint   TundraSurfaceMaterialId;
uint   TundraSubsurfaceMaterialId;
uint   TundraDeepMaterialId;
float2 TundraSubsurfaceZRange;

uint   bHasOre;
uint   OreMaterialId;
uint   OreBaseMaterialId;
float2 OreDepthZRange;
float  OreVeinFrequency;
float  OreVeinThreshold;
float  OreRarity;
float  OreNodeSizeWS;
uint   OreSeed;

RWStructuredBuffer<float> OutDensity;
RWStructuredBuffer<uint>  OutMaterial;

static const uint MAT_Air   = 0u;
static const uint MAT_Grass = 1u;
static const uint MAT_Dirt  = 2u;
static const uint MAT_Stone = 3u;
static const uint MAT_Sand  = 4u;

#ifndef VOXEL_DEBUG_BIOME
#define VOXEL_DEBUG_BIOME 0
#endif

float2 ApplyBiomeDomainWarp(float2 posWS, uint seed)
{
	if (BiomeDomainWarpAmplitude <= 0.0f)
	{
		return posWS;
	}

	const float2 pN = posWS * BiomeDomainWarpFrequency;
	const float warpX = FBM3_Seeded(float3(pN.x, pN.y, 0.0f), 2, 2.0f, 0.5f, seed ^ 0x45C9u);
	const float warpY = FBM3_Seeded(float3(pN.x + 51.7f, pN.y - 19.3f, 0.0f), 2, 2.0f, 0.5f, seed ^ 0x97B3u);
	return posWS + float2(warpX, warpY) * BiomeDomainWarpAmplitude;
}

float SampleBiomeNoise(float2 posWS, float frequency, float2 offset, uint seed)
{
	const float2 p = posWS * frequency + offset;
	const float n = FBM3_Seeded(float3(p.x, p.y, 0.0f), 3, 2.0f, 0.5f, seed);
	return saturate(0.5f + 0.5f * n);
}

uint ResolveBiomeId(float temperature, float moisture)
{
	if (temperature <= BiomeColdTemperature)
	{
		return 2u;
	}

	if (temperature >= BiomeHotTemperature && moisture <= BiomeDryMoisture)
	{
		return 0u;
	}

	return 1u;
}

uint BiomeDebugMaterial(uint biomeId)
{
	if (biomeId == 0u) return MAT_Sand;
	if (biomeId == 1u) return MAT_Grass;
	return MAT_Stone;
}

bool IsNearSurface(float3 posWS, const FVoxelNoiseParams NP, uint seed)
{
	const float3 offsets[6] = {
		float3(-1, 0, 0),
		float3(1, 0, 0),
		float3(0, -1, 0),
		float3(0, 1, 0),
		float3(0, 0, -1),
		float3(0, 0, 1)
	};

	[unroll] for (uint i = 0; i < 6; ++i)
	{
		const float3 samplePos = posWS + offsets[i] * StepSizeWS;
		const float sampleDensity = SampleDensity_Terrain_Noise(samplePos, NP, seed, StepSizeWS);
		if (sampleDensity >= IsoLevel)
		{
			return true;
		}
	}

	return false;
}

uint ComputeBaseMaterial(uint biomeId, float worldZ, bool bNearSurface)
{
	uint surfaceMaterial = PlainsSurfaceMaterialId;
	uint subsurfaceMaterial = PlainsSubsurfaceMaterialId;
	uint deepMaterial = PlainsDeepMaterialId;
	float2 subsurfaceRange = PlainsSubsurfaceZRange;

	if (biomeId == 0u)
	{
		surfaceMaterial = DesertSurfaceMaterialId;
		subsurfaceMaterial = DesertSubsurfaceMaterialId;
		deepMaterial = DesertDeepMaterialId;
		subsurfaceRange = DesertSubsurfaceZRange;
	}
	else if (biomeId == 2u)
	{
		surfaceMaterial = TundraSurfaceMaterialId;
		subsurfaceMaterial = TundraSubsurfaceMaterialId;
		deepMaterial = TundraDeepMaterialId;
		subsurfaceRange = TundraSubsurfaceZRange;
	}

	if (bNearSurface)
	{
		return surfaceMaterial;
	}

	if (worldZ >= subsurfaceRange.x && worldZ <= subsurfaceRange.y)
	{
		return subsurfaceMaterial;
	}

	return deepMaterial;
}

uint ApplyOreOverlay(uint baseMaterial, float density, float3 posWS)
{
	if (bHasOre == 0u || density >= IsoLevel)
	{
		return baseMaterial;
	}

	if (baseMaterial != OreBaseMaterialId)
	{
		return baseMaterial;
	}

	if (posWS.z < OreDepthZRange.x || posWS.z > OreDepthZRange.y)
	{
		return baseMaterial;
	}

	float3 p = posWS * OreVeinFrequency;
	const float vein = FBM3_Seeded(p, 3, 2.0f, 0.5f, OreSeed ^ 0x1E35u);
	float v = saturate(0.5f + 0.5f * vein);

	if (OreNodeSizeWS > 1.0f)
	{
		const float nodeFreq = 1.0f / max(1.0f, OreNodeSizeWS);
		const float node = FBM3_Seeded(posWS * nodeFreq, 2, 2.0f, 0.5f, OreSeed ^ 0x5D1Bu);
		v *= saturate(0.5f + 0.5f * node);
	}

	const float rarityBias = saturate(1.0f - OreRarity) * 0.25f;
	if (v > (OreVeinThreshold + rarityBias))
	{
		return OreMaterialId;
	}

	return baseMaterial;
}

[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
	const uint x = DTid.x;
	const uint y = DTid.y;
	const uint z = DTid.z;

	if (x >= SamplesPerAxis || y >= SamplesPerAxis || z >= SamplesPerAxis)
		return;

	const uint idx = x + y * SamplesPerAxis + z * SamplesPerAxis * SamplesPerAxis;
	const float3 posWS = ChunkOriginWS + float3(x, y, z) * StepSizeWS;
	const FVoxelNoiseParams NP = NoiseParamsBuf[0];

	const float density = SampleDensity_Terrain_Noise(posWS, NP, ChunkSeed, StepSizeWS);
	uint material = MAT_Air;
	if (density < IsoLevel)
	{
		const float2 warpedPos = ApplyBiomeDomainWarp(posWS.xy, BiomeSeed);
		const float temperatureBase = SampleBiomeNoise(warpedPos, BiomeTempMoistureFreq.x, BiomeTempOffset, BiomeSeed ^ 0x1349u);
		const float moistureBase = SampleBiomeNoise(warpedPos, BiomeTempMoistureFreq.y, BiomeMoistureOffset, BiomeSeed ^ 0x8C35u);
		float temperature = temperatureBase - (posWS.z - BiomeSeaLevel) * BiomeTempMoistureHeightInfluence.x;
		float moisture = moistureBase - (posWS.z - BiomeSeaLevel) * BiomeTempMoistureHeightInfluence.y;
		temperature = saturate(temperature);
		moisture = saturate(moisture);

		const uint biomeId = ResolveBiomeId(temperature, moisture);
		const bool bNearSurface = IsNearSurface(posWS, NP, ChunkSeed);
		material = ComputeBaseMaterial(biomeId, posWS.z, bNearSurface);
#if VOXEL_DEBUG_BIOME
		material = BiomeDebugMaterial(biomeId);
#endif
		material = ApplyOreOverlay(material, density, posWS);
	}

	OutDensity[idx] = density;
	// OutMaterial[idx] = material;
	OutMaterial[idx] = 1u;
}
