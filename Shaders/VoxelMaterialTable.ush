#ifndef VOXEL_MATERIAL_TABLE_USH
#define VOXEL_MATERIAL_TABLE_USH

StructuredBuffer<uint4> VoxelMaterialTable;
uint VoxelMaterialTableSize;
uint VoxelUseTableDebugColor;

Texture2DArray VoxelSurfaceAlbedoArray;
SamplerState VoxelSurfaceAlbedoSampler;
Texture2DArray VoxelSurfaceNormalArray;
SamplerState VoxelSurfaceNormalSampler;
Texture2DArray VoxelSurfaceORMArray;
SamplerState VoxelSurfaceORMSampler;
Texture2D VoxelBlockAtlasAlbedo;
SamplerState VoxelBlockAtlasSampler;
uint VoxelBlockAtlasTilesX;
uint VoxelBlockAtlasTilesY;
float VoxelBlockAtlasPadUV;
float VoxelTriPlanarScale;
float VoxelTriPlanarBlendSharpness;
float VoxelTriPlanarNormalStrength;

struct FVoxelMaterialData
{
	float3 DebugColor;
	uint SurfaceLayerIndex;
	uint BlockAtlasIndex;
	float Roughness;
	float Metallic;
	float NormalStrength;
};

uint VoxelExtractByte(uint Packed, uint Shift)
{
	return (Packed >> Shift) & 0xFFu;
}

float VoxelByteToFloat(uint Value)
{
	return float(Value) / 255.0f;
}

uint VoxelUnpackLow16(uint Packed)
{
	return Packed & 0xFFFFu;
}

uint VoxelUnpackHigh16(uint Packed)
{
	return (Packed >> 16) & 0xFFFFu;
}

FVoxelMaterialData VoxelLookupMaterial(uint MaterialId)
{
	FVoxelMaterialData OutData;

	const uint ClampedId = (VoxelMaterialTableSize > 0) ? min(MaterialId, VoxelMaterialTableSize - 1) : 0;
	const uint4 Packed = VoxelMaterialTable[ClampedId];
	// Packed layout:
	// Packed.x = pack2x16(BlockAtlasTopIndex, BlockAtlasSideIndex)
	// Packed.y = pack2x16(BlockAtlasBottomIndex, SurfaceLayerIndex)
	// Packed.z = DebugColor ARGB8
	// Packed.w = Params (Roughness, Metallic, NormalStrength) as 8-bit channels

	const uint PackedColor = Packed.z;
	OutData.BlockAtlasTopIndex = VoxelUnpackLow16(Packed.x);
	OutData.BlockAtlasSideIndex = VoxelUnpackHigh16(Packed.x);
	OutData.BlockAtlasBottomIndex = VoxelUnpackLow16(Packed.y);
	OutData.SurfaceLayerIndex = VoxelUnpackHigh16(Packed.y);

	OutData.DebugColor = float3(
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 16)),
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 8)),
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 0)));

	const uint PackedParams = Packed.w;
	OutData.Roughness = VoxelByteToFloat(VoxelExtractByte(PackedParams, 0));
	OutData.Metallic = VoxelByteToFloat(VoxelExtractByte(PackedParams, 8));
	OutData.NormalStrength = VoxelByteToFloat(VoxelExtractByte(PackedParams, 16));

	return OutData;
}

float4 VoxelResolveDebugColor(uint MaterialId, float4 VertexColor)
{
	if (VoxelUseTableDebugColor != 0)
	{
		const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
		return float4(Mat.DebugColor, 1.0f);
	}

	return VertexColor;
}

float3 VoxelTriPlanarWeights(float3 WorldNormal, float BlendSharpness)
{
	const float3 AbsNormal = abs(WorldNormal);
	float3 Weights = pow(AbsNormal, BlendSharpness);
	const float WeightSum = max(Weights.x + Weights.y + Weights.z, 1e-4f);
	return Weights / WeightSum;
}

float3 VoxelSampleTriPlanarAlbedo(float3 WorldPosition, float3 WorldNormal, uint MaterialId)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
	const float LayerIndex = float(Mat.SurfaceLayerIndex);
	const float InvScale = (VoxelTriPlanarScale > 0.0f) ? (1.0f / VoxelTriPlanarScale) : 1.0f;
	const float3 Weights = VoxelTriPlanarWeights(WorldNormal, max(VoxelTriPlanarBlendSharpness, 1.0f));

	const float2 UVx = WorldPosition.yz * InvScale;
	const float2 UVy = WorldPosition.xz * InvScale;
	const float2 UVz = WorldPosition.xy * InvScale;

	const float3 SampleX = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVx, LayerIndex)).rgb;
	const float3 SampleY = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVy, LayerIndex)).rgb;
	const float3 SampleZ = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVz, LayerIndex)).rgb;

	return SampleX * Weights.x + SampleY * Weights.y + SampleZ * Weights.z;
}

float3 VoxelSampleTriPlanarORM(float3 WorldPosition, float3 WorldNormal, uint MaterialId)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
	const float LayerIndex = float(Mat.SurfaceLayerIndex);
	const float InvScale = (VoxelTriPlanarScale > 0.0f) ? (1.0f / VoxelTriPlanarScale) : 1.0f;
	const float3 Weights = VoxelTriPlanarWeights(WorldNormal, max(VoxelTriPlanarBlendSharpness, 1.0f));

	const float2 UVx = WorldPosition.yz * InvScale;
	const float2 UVy = WorldPosition.xz * InvScale;
	const float2 UVz = WorldPosition.xy * InvScale;

	const float3 SampleX = VoxelSurfaceORMArray.Sample(VoxelSurfaceORMSampler, float3(UVx, LayerIndex)).rgb;
	const float3 SampleY = VoxelSurfaceORMArray.Sample(VoxelSurfaceORMSampler, float3(UVy, LayerIndex)).rgb;
	const float3 SampleZ = VoxelSurfaceORMArray.Sample(VoxelSurfaceORMSampler, float3(UVz, LayerIndex)).rgb;

	return SampleX * Weights.x + SampleY * Weights.y + SampleZ * Weights.z;
}

float3 VoxelUnpackNormal(float3 PackedNormal, float Strength)
{
	float3 Normal = PackedNormal * 2.0f - 1.0f;
	Normal.xy *= Strength;
	return normalize(Normal);
}

float3 VoxelSampleTriPlanarNormalWS(float3 WorldPosition, float3 WorldNormal, uint MaterialId)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
	const float LayerIndex = float(Mat.SurfaceLayerIndex);
	const float InvScale = (VoxelTriPlanarScale > 0.0f) ? (1.0f / VoxelTriPlanarScale) : 1.0f;
	const float3 Weights = VoxelTriPlanarWeights(WorldNormal, max(VoxelTriPlanarBlendSharpness, 1.0f));
	const float NormalStrength = max(VoxelTriPlanarNormalStrength * Mat.NormalStrength, 0.0f);

	const float2 UVx = WorldPosition.yz * InvScale;
	const float2 UVy = WorldPosition.xz * InvScale;
	const float2 UVz = WorldPosition.xy * InvScale;

	const float3 SampleX = VoxelSurfaceNormalArray.Sample(VoxelSurfaceNormalSampler, float3(UVx, LayerIndex)).xyz;
	const float3 SampleY = VoxelSurfaceNormalArray.Sample(VoxelSurfaceNormalSampler, float3(UVy, LayerIndex)).xyz;
	const float3 SampleZ = VoxelSurfaceNormalArray.Sample(VoxelSurfaceNormalSampler, float3(UVz, LayerIndex)).xyz;

	const float3 NormalX = VoxelUnpackNormal(SampleX, NormalStrength);
	const float3 NormalY = VoxelUnpackNormal(SampleY, NormalStrength);
	const float3 NormalZ = VoxelUnpackNormal(SampleZ, NormalStrength);

	const float3 WorldFromX = normalize(float3(0.0f, NormalX.x, NormalX.y) + float3(NormalX.z, 0.0f, 0.0f));
	const float3 WorldFromY = normalize(float3(NormalY.x, 0.0f, NormalY.y) + float3(0.0f, NormalY.z, 0.0f));
	const float3 WorldFromZ = normalize(float3(NormalZ.x, NormalZ.y, 0.0f) + float3(0.0f, 0.0f, NormalZ.z));

	const float3 Blended = WorldFromX * Weights.x + WorldFromY * Weights.y + WorldFromZ * Weights.z;
	return normalize(Blended);
}

float3 VoxelWorldNormalToTangent(float3 WorldN, float3x3 TangentToWorld)
{
	const float3 TangentN = mul(WorldN, transpose(TangentToWorld));
	return normalize(TangentN);
}

float3 VoxelApplyTangentNormalDebug(float3 TangentNormal)
{
	if (VoxelUseTableDebugColor != 0)
	{
		return float3(0.0f, 0.0f, 1.0f);
	}

	return TangentNormal;
}

void VoxelResolveSurfaceShading(
	float3 WorldPosition,
	float3 WorldNormal,
	uint MaterialId,
	out float3 OutBaseColor,
	out float3 OutWorldNormal,
	out float OutAO,
	out float OutRoughness,
	out float OutMetallic)
{
	if (VoxelUseTableDebugColor != 0)
	{
		const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
		OutBaseColor = Mat.DebugColor;
		OutWorldNormal = WorldNormal;
		OutAO = 1.0f;
		OutRoughness = 0.8f;
		OutMetallic = 0.0f;
		return;
	}

	OutBaseColor = VoxelSampleTriPlanarAlbedo(WorldPosition, WorldNormal, MaterialId);
	OutWorldNormal = VoxelSampleTriPlanarNormalWS(WorldPosition, WorldNormal, MaterialId);
	const float3 ORM = VoxelSampleTriPlanarORM(WorldPosition, WorldNormal, MaterialId);
	OutAO = ORM.x;
	OutRoughness = ORM.y;
	OutMetallic = ORM.z;
}

void VoxelResolveSurfaceShading_Tangent(
	float3 WorldPosition,
	float3 WorldNormal,
	float3x3 TangentToWorld,
	uint MaterialId,
	out float3 OutBaseColor,
	out float3 OutTangentNormal,
	out float OutAO,
	out float OutRoughness,
	out float OutMetallic)
{
	float3 ResolvedWorldNormal = WorldNormal;
	VoxelResolveSurfaceShading(
		WorldPosition,
		WorldNormal,
		MaterialId,
		OutBaseColor,
		ResolvedWorldNormal,
		OutAO,
		OutRoughness,
		OutMetallic);

	OutTangentNormal = VoxelWorldNormalToTangent(ResolvedWorldNormal, TangentToWorld);
	OutTangentNormal = VoxelApplyTangentNormalDebug(OutTangentNormal);
}

float4 VoxelResolveSurfaceColor(float3 WorldPosition, float3 WorldNormal, uint MaterialId, float4 VertexColor)
{
	if (VoxelUseTableDebugColor != 0)
	{
		const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
		return float4(Mat.DebugColor, 1.0f);
	}

	return float4(VoxelSampleTriPlanarAlbedo(WorldPosition, WorldNormal, MaterialId), 1.0f);
}

float2 VoxelComputeBlockFaceUV(float3 WorldPosition, float3 WorldNormal)
{
	const float3 AbsNormal = abs(WorldNormal);
	float2 FaceUV = float2(0.0f, 0.0f);

	if (AbsNormal.x >= AbsNormal.y && AbsNormal.x >= AbsNormal.z)
	{
		FaceUV = frac(WorldPosition.zy);
	}
	else if (AbsNormal.y >= AbsNormal.z)
	{
		FaceUV = frac(WorldPosition.xz);
	}
	else
	{
		FaceUV = frac(WorldPosition.xy);
	}

	return FaceUV;
}

float2 VoxelComputeBlockAtlasUV(float2 InFaceUV, uint Tile, uint TilesX, uint TilesY, float PadUV)

{
	const uint TileX = Tile % TilesX;
	const uint TileY = Tile / TilesX;
	const float2 Tiles = float2(TilesX, TilesY);
	InFaceUV = lerp(PadUV.xx, (1.0f - PadUV).xx, InFaceUV);

	return (float2(TileX, TileY) + InFaceUV) / Tiles;
}

uint VoxelSelectBlockTileIndex(uint MaterialId, float3 WorldNormal)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
	const float3 Normal = normalize(WorldNormal);
	const float3 AbsNormal = abs(Normal);

	if (AbsNormal.z >= AbsNormal.x && AbsNormal.z >= AbsNormal.y)
	{
		return (Normal.z >= 0.0f) ? Mat.BlockAtlasTopIndex : Mat.BlockAtlasBottomIndex;
	}

	return Mat.BlockAtlasSideIndex;
}

void VoxelResolveBlockSurface(
	uint MaterialId,
	float2 InFaceUV,
	float3 WorldNormal,
	Texture2D BlockAtlasTex,
	SamplerState BlockAtlasSamp,
	out float3 OutBaseColor,
	out float OutAO,
	out float OutRoughness,
	out float OutMetallic)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);

	if (VoxelUseTableDebugColor != 0)
	{
		OutBaseColor = Mat.DebugColor;
		OutAO = 1.0f;
		OutRoughness = 0.8f;
		OutMetallic = 0.0f;
		return;
	}

	const uint BlockAtlasIndex = VoxelSelectBlockTileIndex(MaterialId, WorldNormal);
	const float2 AtlasUV = VoxelComputeBlockAtlasUV(InFaceUV, BlockAtlasIndex, VoxelBlockAtlasTilesX, VoxelBlockAtlasTilesY, VoxelBlockAtlasPadUV);;

	OutBaseColor = Texture2DSample(BlockAtlasTex, BlockAtlasSamp, AtlasUV).rgb;

	OutAO = 1.0f;
	OutRoughness = Mat.Roughness;
	OutMetallic = Mat.Metallic;
}

#endif
