#ifndef VOXEL_MATERIAL_TABLE_USH
#define VOXEL_MATERIAL_TABLE_USH

StructuredBuffer<uint4> VoxelMaterialTable;
uint VoxelMaterialTableSize;
uint VoxelUseTableDebugColor;

Texture2DArray VoxelSurfaceAlbedoArray;
SamplerState VoxelSurfaceAlbedoSampler;
float VoxelTriPlanarScale;
float VoxelTriPlanarBlendSharpness;

struct FVoxelMaterialData
{
	float3 DebugColor;
	uint SurfaceLayerIndex;
	uint BlockAtlasIndex;
	float Roughness;
	float Metallic;
	float NormalStrength;
};

uint VoxelExtractByte(uint Packed, uint Shift)
{
	return (Packed >> Shift) & 0xFFu;
}

float VoxelByteToFloat(uint Value)
{
	return float(Value) / 255.0f;
}

FVoxelMaterialData VoxelLookupMaterial(uint MaterialId)
{
	FVoxelMaterialData OutData;

	const uint ClampedId = (VoxelMaterialTableSize > 0) ? min(MaterialId, VoxelMaterialTableSize - 1) : 0;
	const uint4 Packed = VoxelMaterialTable[ClampedId];

	const uint PackedColor = Packed.z;
	OutData.SurfaceLayerIndex = Packed.x;
	OutData.BlockAtlasIndex = Packed.y;

	OutData.DebugColor = float3(
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 16)),
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 8)),
		VoxelByteToFloat(VoxelExtractByte(PackedColor, 0)));

	const uint PackedParams = Packed.w;
	OutData.Roughness = VoxelByteToFloat(VoxelExtractByte(PackedParams, 0));
	OutData.Metallic = VoxelByteToFloat(VoxelExtractByte(PackedParams, 8));
	OutData.NormalStrength = VoxelByteToFloat(VoxelExtractByte(PackedParams, 16));

	return OutData;
}

float4 VoxelResolveDebugColor(uint MaterialId, float4 VertexColor)
{
	if (VoxelUseTableDebugColor != 0)
	{
		const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
		return float4(Mat.DebugColor, 1.0f);
	}

	return VertexColor;
}

float3 VoxelTriPlanarWeights(float3 WorldNormal, float BlendSharpness)
{
	const float3 AbsNormal = abs(WorldNormal);
	float3 Weights = pow(AbsNormal, BlendSharpness);
	const float WeightSum = max(Weights.x + Weights.y + Weights.z, 1e-4f);
	return Weights / WeightSum;
}

float3 VoxelSampleTriPlanarAlbedo(float3 WorldPosition, float3 WorldNormal, uint MaterialId)
{
	const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
	const float LayerIndex = float(Mat.SurfaceLayerIndex);
	const float InvScale = (VoxelTriPlanarScale > 0.0f) ? (1.0f / VoxelTriPlanarScale) : 1.0f;
	const float3 Weights = VoxelTriPlanarWeights(WorldNormal, max(VoxelTriPlanarBlendSharpness, 1.0f));

	const float2 UVx = WorldPosition.yz * InvScale;
	const float2 UVy = WorldPosition.xz * InvScale;
	const float2 UVz = WorldPosition.xy * InvScale;

	const float3 SampleX = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVx, LayerIndex)).rgb;
	const float3 SampleY = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVy, LayerIndex)).rgb;
	const float3 SampleZ = VoxelSurfaceAlbedoArray.Sample(VoxelSurfaceAlbedoSampler, float3(UVz, LayerIndex)).rgb;

	return SampleX * Weights.x + SampleY * Weights.y + SampleZ * Weights.z;
}

float4 VoxelResolveSurfaceColor(float3 WorldPosition, float3 WorldNormal, uint MaterialId, float4 VertexColor)
{
	if (VoxelUseTableDebugColor != 0)
	{
		const FVoxelMaterialData Mat = VoxelLookupMaterial(MaterialId);
		return float4(Mat.DebugColor, 1.0f);
	}

	return float4(VoxelSampleTriPlanarAlbedo(WorldPosition, WorldNormal, MaterialId), 1.0f);
}

#endif
