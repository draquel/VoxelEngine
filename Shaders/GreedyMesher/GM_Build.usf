// /Plugin/Voxel/GreedyMesher/GM_Build.usf

#include "/Engine/Private/Common.ush"
#include "../Noise/VoxelDensity.ush"

float3 ChunkOriginWS;
float  ChunkSizeWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;
uint   MaxVertices;
uint   MaxIndices;

StructuredBuffer<FVoxelNoiseParams> NoiseParamsBuf;

RWBuffer<float4> OutVertices;
RWBuffer<uint>   OutIndices;
RWBuffer<float4> OutNormals;
RWStructuredBuffer<uint> OutVertexCount;
RWStructuredBuffer<uint> OutIndexCount;

float GetDensity(int3 c)
{
	if (any(c < 0) || any(c >= (int)CellsPerAxis))
	{
		// Treat outside as empty for internal face culling, 
		// but we need to decide if we want to cap the chunk.
		// Usually we want to cap if the neighbor chunk isn't solid.
		// For simplicity, let's sample.
	}
	float3 posWS = ChunkOriginWS + (float3(c) + 0.5f) * StepSizeWS;
	FVoxelNoiseParams NP = NoiseParamsBuf[0];
	return SampleDensity_Terrain_Noise(posWS, NP, ChunkSeed,StepSizeWS);
}

// 0: -x, 1: +x, 2: -y, 3: +y, 4: -z, 5: +z
static const int3 NeighborOfs[6] = {
	int3(-1, 0, 0), int3(1, 0, 0),
	int3(0, -1, 0), int3(0, 1, 0),
	int3(0, 0, -1), int3(0, 0, 1)
};

static const float3 Normals[6] = {
	float3(1, 0, 0), float3(-1, 0, 0),
	float3(0, 1, 0), float3(0, -1, 0),
	float3(0, 0, 1), float3(0, 0, -1)
};

void EmitFace(int3 c, uint faceIdx)
{
	uint vBase;
	InterlockedAdd(OutVertexCount[0], 4, vBase);
	uint iBase;
	InterlockedAdd(OutIndexCount[0], 6, iBase);

	if (vBase + 4 > MaxVertices || iBase + 6 > MaxIndices)
	{
		return;
	}

	float3 p0 = float3(c) * StepSizeWS;
	float3 p1 = p0 + StepSizeWS;

	float3 v[4];
	if (faceIdx == 0) { // -x
		v[0] = float3(p0.x, p0.y, p0.z);
		v[1] = float3(p0.x, p0.y, p1.z);
		v[2] = float3(p0.x, p1.y, p1.z);
		v[3] = float3(p0.x, p1.y, p0.z);
	} else if (faceIdx == 1) { // +x
		v[0] = float3(p1.x, p0.y, p0.z);
		v[1] = float3(p1.x, p1.y, p0.z);
		v[2] = float3(p1.x, p1.y, p1.z);
		v[3] = float3(p1.x, p0.y, p1.z);
	} else if (faceIdx == 2) { // -y
		v[0] = float3(p0.x, p0.y, p0.z);
		v[1] = float3(p1.x, p0.y, p0.z);
		v[2] = float3(p1.x, p0.y, p1.z);
		v[3] = float3(p0.x, p0.y, p1.z);
	} else if (faceIdx == 3) { // +y
		v[0] = float3(p0.x, p1.y, p0.z);
		v[1] = float3(p0.x, p1.y, p1.z);
		v[2] = float3(p1.x, p1.y, p1.z);
		v[3] = float3(p1.x, p1.y, p0.z);
	} else if (faceIdx == 4) { // -z
		v[0] = float3(p0.x, p0.y, p0.z);
		v[1] = float3(p0.x, p1.y, p0.z);
		v[2] = float3(p1.x, p1.y, p0.z);
		v[3] = float3(p1.x, p0.y, p0.z);
	} else { // +z
		v[0] = float3(p0.x, p0.y, p1.z);
		v[1] = float3(p1.x, p0.y, p1.z);
		v[2] = float3(p1.x, p1.y, p1.z);
		v[3] = float3(p0.x, p1.y, p1.z);
	}

	float3 n = Normals[faceIdx];

	for (uint i = 0; i < 4; ++i)
	{
		OutVertices[vBase + i] = float4(v[i], 1.0f);
		OutNormals[vBase + i]  = float4(n, 0.0f);
	}

	OutIndices[iBase + 0] = vBase + 0;
	OutIndices[iBase + 1] = vBase + 1;
	OutIndices[iBase + 2] = vBase + 2;
	OutIndices[iBase + 3] = vBase + 0;
	OutIndices[iBase + 4] = vBase + 2;
	OutIndices[iBase + 5] = vBase + 3;
}

[numthreads(4, 4, 4)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
	if (any(DTid >= CellsPerAxis)) return;

	int3 c = int3(DTid);
	float d = GetDensity(c);

	if (d < IsoLevel) return; // Empty

	[unroll]
	for (uint i = 0; i < 6; ++i)
	{
		if (GetDensity(c + NeighborOfs[i]) < IsoLevel)
		{
			EmitFace(c, i);
		}
	}
}
