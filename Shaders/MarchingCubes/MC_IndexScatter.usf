#include "/Engine/Private/Common.ush"

uint NumCells;

StructuredBuffer<uint> TriCountPerCell;
StructuredBuffer<uint> TriOffsetPerCell;   // in triangles
StructuredBuffer<uint> VertOffsetPerCell;  // in vertices (NOT bytes)

RWStructuredBuffer<uint> OutIndices;

[numthreads(64,1,1)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint cell = DTid.x;
    if (cell >= NumCells) return;

    uint triCount = TriCountPerCell[cell];
    if (triCount == 0) return;

    uint triBase  = TriOffsetPerCell[cell];
    uint vertBase = VertOffsetPerCell[cell];

    // Each tri = 3 vertices (unique verts strategy)
    for (uint t = 0; t < triCount; ++t)
    {
        uint i0 = vertBase + t*3 + 0;
        uint i1 = vertBase + t*3 + 1;
        uint i2 = vertBase + t*3 + 2;

        uint outIndex = (triBase + t) * 3;
        OutIndices[outIndex + 0] = i0;
        OutIndices[outIndex + 1] = i1;
        OutIndices[outIndex + 2] = i2;
    }
}

