#include "/Engine/Private/Common.ush"

uint MaxVerts;
Buffer<float4> InNormals;
RWBuffer<uint> OutPacked;

int PackSnorm8(float v)
{
	v = clamp(v, -1.0, 1.0);
	int iv = (int)round(v * 127.0);
	return clamp(iv, -127, 127);
}

uint PackToVET_PackedNormal_SNORM(float4 v)
{
	int x = PackSnorm8(v.x);
	int y = PackSnorm8(v.y);
	int z = PackSnorm8(v.z);
	int w = PackSnorm8(v.w);

	uint ux = (uint)(x & 0xFF);
	uint uy = (uint)(y & 0xFF);
	uint uz = (uint)(z & 0xFF);
	uint uw = (uint)(w & 0xFF);

	return ux | (uy << 8) | (uz << 16) | (uw << 24);
}

void BuildBasis(float3 n, out float3 t, out float signW)
{
	float3 up = (abs(n.z) < 0.999f) ? float3(0,0,1) : float3(0,1,0);
	t = normalize(cross(up, n));
	signW = 1.0f;
}

[numthreads(128,1,1)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
	uint i = DTid.x;
	if (i >= MaxVerts) return;

	float3 raw = InNormals[i].xyz;
	if (length(raw) < 0.01f)
	{
		// TangentX (with sign in W), Normal
		OutPacked[i * 2 + 0] = PackToVET_PackedNormal_SNORM(float4(1, 0, 0, 1));
		OutPacked[i * 2 + 1] = PackToVET_PackedNormal_SNORM(float4(0, 0, 1, 0));
		return;
	}

	float3 n = normalize(raw);

	float3 t;
	float signW;
	BuildBasis(n, t, signW);

	OutPacked[i * 2 + 0] = PackToVET_PackedNormal_SNORM(float4(t, signW)); // TangentX
	OutPacked[i * 2 + 1] = PackToVET_PackedNormal_SNORM(float4(n, 0.0f));  // Normal
}
