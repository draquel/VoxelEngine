// /Plugin/Voxel/MarchingCubes/MC_Count.usf

#include "/Engine/Private/Common.ush"
#include "../Noise/VoxelDensity.ush"
#include "MC_Tables.ush"

float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;   // unused for now
uint   Padding0;  

StructuredBuffer<FVoxelNoiseParams> NoiseParamsBuf;

RWStructuredBuffer<uint> OutTriCountPerCell;   // NumCells
RWStructuredBuffer<uint> OutVertCountPerCell;  // NumCells
RWStructuredBuffer<uint> OutCaseIndexPerCell;  // NumCells

uint ComputeCaseIndex(float3 cellMinWS)
{
    uint caseIndex = 0;

    [unroll]
    for (uint i = 0; i < 8; ++i)
    {
        float3 p = cellMinWS + CornerOfs[i] * StepSizeWS;
        // float  d = SampleDensityWS(p,NoiseParams.Seed);
        FVoxelNoiseParams NP = NoiseParamsBuf[0];
        float d = SampleDensity_Terrain_Noise(p,NP,ChunkSeed);

        // "inside" if d < IsoLevel
        caseIndex |= (d < IsoLevel) ? (1u << i) : 0u;
    }

    return caseIndex;
}

uint CountTrisFromTriTable(uint caseIndex)
{
    // TriTable rows are 16 ints, -1 terminated, in groups of 3 edges per triangle
    uint triCount = 0;

    [unroll]
    for (uint t = 0; t < 16; t += 3)
    {
        int e0 = TriTable[caseIndex][t + 0];
        if (e0 < 0) break;
        triCount++;
    }

    return triCount; // 0..5
}

[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint x = DTid.x, y = DTid.y, z = DTid.z;
    if (x >= CellsPerAxis || y >= CellsPerAxis || z >= CellsPerAxis)
        return;

    float3 cellMinWS = ChunkOriginWS + float3(x, y, z) * StepSizeWS;
    uint cellIndex = x + y * CellsPerAxis + z * CellsPerAxis * CellsPerAxis;

    // Compute case index exactly once
    uint caseIndex = 0;
    [unroll]
    for (uint i = 0; i < 8; ++i)
    {
        float3 p = cellMinWS + CornerOfs[i] * StepSizeWS;
        // float d  = SampleDensityWS(p,NoiseParams.Seed);
        FVoxelNoiseParams NP = NoiseParamsBuf[0];
        float d = SampleDensity_Terrain_Noise(p,NP,ChunkSeed);
        caseIndex |= (d < IsoLevel) ? (1u << i) : 0u;
    }

    OutCaseIndexPerCell[cellIndex] = caseIndex;

    // Empty or full → no geometry
    if (caseIndex == 0 || caseIndex == 255)
    {
        OutTriCountPerCell[cellIndex]  = 0;
        OutVertCountPerCell[cellIndex] = 0;
        return;
    }

    // Canonical marching cubes counts
    uint triCount = CountTrisFromTriTable(caseIndex);
    OutTriCountPerCell[cellIndex]  = triCount;
    OutVertCountPerCell[cellIndex] = triCount * 3;

}
