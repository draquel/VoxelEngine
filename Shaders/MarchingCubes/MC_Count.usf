#include "/Engine/Private/Common.ush"
#include "MC_Tables.ush"

// ------------------------
// HLSL type for NoiseParams
// This MUST match your C++ BEGIN_GLOBAL_SHADER_PARAMETER_STRUCT(FVoxelNoiseParams,...)
// ------------------------
struct FVoxelNoiseParams
{
    float3 WorldScale;
    float  HeightAmp;

    float  HeightFreq;
    float  HeightGain;
    uint   HeightOctaves;

    float  OverhangFreq;
    float  OverhangAmp;
    uint   OverhangOctaves;

    float  CaveFreq;
    float  CaveAmp;
    float  CaveThreshold;
    float  CaveSoftness;

    uint   Seed;
    float3 _Padding;
};

// Injected by UE from your parameter struct:
float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;
uint   Padding0;

// Injected by UE because you used SHADER_PARAMETER_STRUCT_REF(FVoxelNoiseParams, NoiseParams)
FVoxelNoiseParams NoiseParams;

// Outputs (UAV)
RWStructuredBuffer<uint> OutTriCountPerCell;   // length = CellsPerAxis^3
RWStructuredBuffer<uint> OutVertCountPerCell;  // length = CellsPerAxis^3
RWStructuredBuffer<uint> OutCaseIndexPerCell;


// ---- Density function ----
// For now: plane test (as you’re doing).
// Replace with your real noise function later (using NoiseParams).
float SampleDensityWS(float3 Pws)
{
    // Canonical plane: iso at z=0
    return Pws.z;
}

uint ComputeCaseIndex(float3 cellMinWS)
{
    uint caseIndex = 0;
    [unroll] for (uint i = 0; i < 8; ++i)
    {
        float3 p = cellMinWS + CornerOfs[i] * StepSizeWS;
        float d  = SampleDensityWS(p);
        caseIndex |= (d < IsoLevel) ? (1u << i) : 0u;
    }
    return caseIndex;
}

uint CountTrisFromTriTable(uint caseIndex)
{
    // TriTable row has 16 ints, -1 terminates
    uint triCount = 0;
    [unroll] for (uint t = 0; t < 16; t += 3)
    {
        int e0 = TriTable[caseIndex][t + 0];
        if (e0 < 0) break;
        triCount++;
    }
    return triCount;
}

[numthreads(256,1,1)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint cellIndex = DTid.x;
    uint NumCells = CellsPerAxis * CellsPerAxis * CellsPerAxis;
    if (cellIndex >= NumCells)
        return;

    // --- compute (x,y,z) from linear index ---
    uint z = cellIndex / (CellsPerAxis * CellsPerAxis);
    uint rem = cellIndex - z * CellsPerAxis * CellsPerAxis;
    uint y = rem / CellsPerAxis;
    uint x = rem - y * CellsPerAxis;

    float3 cellMinWS = ChunkOriginWS + float3(x,y,z) * StepSizeWS;

    uint caseIndex = ComputeCaseIndex(cellMinWS);
    
    uint triCount = CountTrisFromTriTable(caseIndex); // canonical table
    uint vertCount = triCount * 3;

    OutTriCountPerCell[cellIndex]  = triCount;
    OutVertCountPerCell[cellIndex] = vertCount;
    OutCaseIndexPerCell[cellIndex] = caseIndex;
}