#include "/Engine/Private/Common.ush"
#include "MC_Tables.ush"

// ---- Parameters ----
float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;

// ---- Outputs ----
RWStructuredBuffer<uint> OutTriCountPerCell;
RWStructuredBuffer<uint> OutVertCountPerCell;

// ---- Helpers ----
// static const float3 CornerOfs[8] =
// {
//     float3(0,0,0), float3(1,0,0), float3(1,1,0), float3(0,1,0),
//     float3(0,0,1), float3(1,0,1), float3(1,1,1), float3(0,1,1)
// };

// Simple deterministic density (flat plane)
float SampleDensityWS(float3 p)
{
    return p.z;
}

uint ComputeCaseIndex(float3 cellMinWS)
{
    uint caseIndex = 0;
    [unroll]
    for (uint i = 0; i < 8; ++i)
    {
        float3 p = cellMinWS + CornerOfs[i] * StepSizeWS;
        float d  = SampleDensityWS(p);
        caseIndex |= (d < IsoLevel) ? (1u << i) : 0u;
    }
    return caseIndex;
}

[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint x = DTid.x;
    uint y = DTid.y;
    uint z = DTid.z;

    if (x >= CellsPerAxis || y >= CellsPerAxis || z >= CellsPerAxis)
        return;

    uint cellIndex =
        x +
        y * CellsPerAxis +
        z * CellsPerAxis * CellsPerAxis;

    float3 cellMinWS =
        ChunkOriginWS + float3(x, y, z) * StepSizeWS;

    uint caseIndex = ComputeCaseIndex(cellMinWS);

    // Empty / full cells
    if (caseIndex == 0 || caseIndex == 255)
    {
        OutTriCountPerCell[cellIndex]  = 0;
        OutVertCountPerCell[cellIndex] = 0;
        return;
    }

    // Count triangles from TriTable
    uint triCount = 0;
    [unroll]
    for (uint i = 0; i < 16; i += 3)
    {
        if (TriTable[caseIndex][i] < 0)
            break;
        triCount++;
    }

    OutTriCountPerCell[cellIndex]  = triCount;
    OutVertCountPerCell[cellIndex] = triCount * 3;
}