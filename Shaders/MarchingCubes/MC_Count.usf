#include "/Engine/Public/Platform.ush"
#include "../Noise/VoxelNoiseParams.ush"
#include "../Noise/VoxelNoiseFast3D.usf"

float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;
uint   Padding0;

RWStructuredBuffer<uint> OutTriCountPerCell;
RWStructuredBuffer<uint> OutVertCountPerCell;

// Corner offsets for a cell in (x,y,z) in [0,1]
static const uint3 CornerOfs[8] =
{
    uint3(0,0,0),
    uint3(1,0,0),
    uint3(1,1,0),
    uint3(0,1,0),
    uint3(0,0,1),
    uint3(1,0,1),
    uint3(1,1,1),
    uint3(0,1,1)
};

float SampleDensityWS(float3 Pws)
{
    // Convert world -> noise space
    float3 p = Pws * WorldScale;

    // Macro height (2.5D)
    float height =
        FBM3(float3(p.x * HeightFreq, p.y * HeightFreq, 0.0),
             (int)HeightOctaves, 2.0, HeightGain) * HeightAmp;

    float density = Pws.z - height;

    // Overhangs (true 3D)
    density += FBM3(p * OverhangFreq, (int)OverhangOctaves, 2.0, 0.5) * OverhangAmp;

    // Caves (masked)
    float caveN = FBM3(p * CaveFreq, 3, 2.0, 0.5);
    float caveMask = smoothstep(CaveThreshold, CaveThreshold + CaveSoftness, caveN);

    // NOTE: sign here controls whether mask hollows or fills.
    // With density = Pws.z - height, adding pushes "outside" up -> can create hollow pockets depending on IsoLevel.
    density -= caveMask * CaveAmp;

    return density;
}

uint ComputeCaseIndex(float3 cellMinWS)
{
    uint caseIndex = 0;
    const float step = StepSizeWS;

    // Corner bits: (x,y,z) => bit = x + 2y + 4z
    [unroll] for (uint dz = 0; dz < 2; ++dz)
        [unroll] for (uint dy = 0; dy < 2; ++dy)
            [unroll] for (uint dx = 0; dx < 2; ++dx)
            {
                float3 p = cellMinWS + float3(dx, dy, dz) * step;
                // float d = SampleDensityWS(p);
                float d = p.z; // flat plane at Z=0
                uint bit = dx + (dy << 1) + (dz << 2);
                caseIndex |= (d < IsoLevel) ? (1u << bit) : 0u;
            }
    return caseIndex;
}

static const uint TriCountTable[256] =
{
    0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,2,
    1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,3,
    1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,3,
    2,3,3,2,3,4,4,3,3,4,4,3,4,5,5,2,
    1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,3,
    2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,4,
    2,3,3,4,3,4,2,3,3,4,4,5,4,5,3,2,
    3,4,4,3,4,5,3,2,4,5,5,4,5,2,4,1,
    1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,3,
    2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,4,
    2,3,3,4,3,4,2,3,3,4,4,5,4,5,3,2,
    3,4,4,3,4,5,3,2,4,5,5,4,5,2,4,1,
    2,3,3,2,3,4,4,3,3,4,4,3,4,5,5,2,
    3,4,4,3,4,5,5,4,4,5,5,4,5,4,4,1,
    3,4,4,3,4,5,3,2,4,5,5,4,5,2,4,1,
    2,3,3,1,3,4,2,1,3,4,4,3,4,1,3,0
};

uint NumTrisForCase(uint caseIndex)
{
    return TriCountTable[caseIndex & 255];
}

[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint x = DTid.x, y = DTid.y, z = DTid.z;
    if (x >= CellsPerAxis || y >= CellsPerAxis || z >= CellsPerAxis) return;

    uint cellIndex = x + y * CellsPerAxis + z * CellsPerAxis * CellsPerAxis;

    float3 cellMinWS = ChunkOriginWS + float3(x, y, z) * StepSizeWS;
    uint caseIndex   = ComputeCaseIndex(cellMinWS);

    uint triCount = NumTrisForCase(caseIndex);
    OutTriCountPerCell[cellIndex]  = triCount;
    OutVertCountPerCell[cellIndex] = triCount * 3;
}
