#include "/Engine/Private/Common.ush"
#include "MC_Tables.ush"

// If you have a matching .ush for noise params, you can include it too,
// but you don't need it for this plane test:
// #include "VoxelNoiseParams.ush"

// ---- Parameters injected by UE parameter struct ----
float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
uint   SamplesPerAxis;
float  IsoLevel;
uint   ChunkSeed;
uint   MaxVerts;
uint   bUseCaseIndexPerCell;

StructuredBuffer<float> DensityField;
StructuredBuffer<uint>  MaterialField;

// From Count + Scan
StructuredBuffer<uint> VertCountPerCell; // N cells, verts-per-cell (triCount*3)
StructuredBuffer<uint> VertOffsets;      // N cells, exclusive prefix sum of VertCountPerCell
StructuredBuffer<uint> CaseIndexPerCell;

// Output
RWBuffer<float4> OutVertices;  // sized to NumCells*15 on CPU; only [0..TotalVerts) is valid
RWBuffer<uint>   OutMaterialIds;
RWBuffer<uint>   OutVertexColors;

static const uint MAT_Air   = 0u;
static const uint MAT_Grass = 1u;
static const uint MAT_Dirt  = 2u;
static const uint MAT_Stone = 3u;
static const uint MAT_Sand  = 4u;
static const uint MAT_Snow  = 5u;
static const uint MAT_Ore   = 6u;

#ifndef VOXEL_MC_MATERIAL_MODE
#define VOXEL_MC_MATERIAL_MODE 1
#endif

#ifndef VOXEL_MC_MAT_TIEBREAK_PRIORITY
#define VOXEL_MC_MAT_TIEBREAK_PRIORITY 0
#endif

#ifndef VOXEL_MC_MAT_TIEBREAK_DEEP
#define VOXEL_MC_MAT_TIEBREAK_DEEP 0
#endif

#if VOXEL_MC_MAT_TIEBREAK_PRIORITY && VOXEL_MC_MAT_TIEBREAK_DEEP
#error "VOXEL_MC_MAT_TIEBREAK_PRIORITY and VOXEL_MC_MAT_TIEBREAK_DEEP are mutually exclusive."
#endif

uint PackColor(uint r, uint g, uint b, uint a)
{
	return (b) | (g << 8) | (r << 16) | (a << 24);
}

uint MaterialIdToColor(uint material)
{
	switch (material)
	{
	case MAT_Grass: return PackColor(32, 200, 64, 255);
	case MAT_Dirt:  return PackColor(120, 72, 32, 255);
	case MAT_Stone: return PackColor(128, 128, 128, 255);
	case MAT_Sand:  return PackColor(210, 190, 80, 255);
	case MAT_Snow:  return PackColor(220, 230, 245, 255);
	case MAT_Ore:   return PackColor(220, 120, 64, 255);
	default:        return PackColor(10, 10, 10, 255);
	}
}

uint SampleIndex(uint3 s)
{
	return s.x + s.y * SamplesPerAxis + s.z * SamplesPerAxis * SamplesPerAxis;
}

// Old baseline selection: pick the most "solid" corner by density.
// Updated: ignore MAT_Air materials for compare-mode usefulness.
uint SelectCornerMaterial(uint3 cell, float cd[8])
{
	uint bestId = MAT_Air;
	float bestDensity = 3.4e38f;

	[unroll] for (uint i = 0; i < 8; ++i)
	{
		if (cd[i] < IsoLevel && cd[i] < bestDensity)
		{
			const uint3 s = cell + (uint3)CornerOfs[i];
			const uint si = SampleIndex(s);
			const uint mat = MaterialField[si];

			// If material is Air, keep searching (compare mode is more meaningful)
			if (mat == MAT_Air)
				continue;

			bestDensity = cd[i];
			bestId = mat;
		}
	}

	return bestId;
}

uint MaterialPriority(uint material)
{
#if VOXEL_MC_MAT_TIEBREAK_PRIORITY
	switch (material)
	{
	case MAT_Stone: return 3u;
	case MAT_Dirt:  return 2u;
	case MAT_Sand:  return 1u;
	case MAT_Grass: return 0u;
	default:        return 0u;
	}
#else
	return 0u;
#endif
}

#if VOXEL_MC_MAT_TIEBREAK_DEEP
float BestSolidCornerZForMaterial(uint mat, float3 cpos[8], float cd[8], uint cornerMats[8])
{
	// Lower Z => "deeper". Consider only SOLID corners for that material.
	float bestZ = 3.4e38f;
	[unroll] for (uint i = 0; i < 8; ++i)
	{
		if (cornerMats[i] == mat && cd[i] < IsoLevel)
		{
			bestZ = min(bestZ, cpos[i].z);
		}
	}
	return bestZ;
}
#endif

#if VOXEL_MC_MAT_TIEBREAK_DEEP
uint ComputeDominantMaterial8(
	uint m0, uint m1, uint m2, uint m3,
	uint m4, uint m5, uint m6, uint m7,
	float3 cpos[8], float cd[8], uint cornerMats[8])
#else
uint ComputeDominantMaterial8(
	uint m0, uint m1, uint m2, uint m3,
	uint m4, uint m5, uint m6, uint m7)
#endif
{
	// 8-bucket vote: handles up to 8 unique materials (no silent overflow).
	uint ids[8]    = { 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u };
	uint counts[8] = { 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u };

	uint nonAirCount = 0u;
	uint mats[8] = { m0, m1, m2, m3, m4, m5, m6, m7 };

	[unroll] for (uint i = 0; i < 8; ++i)
	{
		const uint mat = mats[i];
		if (mat != MAT_Air) nonAirCount += 1u;

		bool matched = false;

		// Match existing bucket
		[unroll] for (uint b = 0; b < 8; ++b)
		{
			if (counts[b] > 0 && ids[b] == mat)
			{
				counts[b] += 1u;
				matched = true;
				break;
			}
		}

		// Insert into first empty bucket
		if (!matched)
		{
			[unroll] for (uint b = 0; b < 8; ++b)
			{
				if (counts[b] == 0)
				{
					ids[b] = mat;
					counts[b] = 1u;
					matched = true;
					break;
				}
			}
		}
	}

	// If any non-air exists, exclude Air from candidates.
	if (nonAirCount > 0)
	{
		[unroll] for (uint b = 0; b < 8; ++b)
		{
			if (counts[b] > 0 && ids[b] == MAT_Air)
			{
				counts[b] = 0u;
			}
		}
	}

	// Initialize best to first non-empty bucket (deterministic).
	uint bestId = MAT_Air;
	uint bestCount = 0u;
	uint bestPriority = 0u;
#if VOXEL_MC_MAT_TIEBREAK_DEEP
	float bestZ = 3.4e38f;
#endif

	[unroll] for (uint b = 0; b < 8; ++b)
	{
		if (counts[b] == 0) continue;
		bestId = ids[b];
		bestCount = counts[b];
		bestPriority = MaterialPriority(bestId);
#if VOXEL_MC_MAT_TIEBREAK_DEEP
		bestZ = BestSolidCornerZForMaterial(bestId, cpos, cd, cornerMats);
#endif
		break;
	}

	// Select best by count; on ties apply optional tie-breaks (otherwise keep first-seen).
	[unroll] for (uint b = 0; b < 8; ++b)
	{
		if (counts[b] == 0)
			continue;

		const uint candId = ids[b];
		const uint candCount = counts[b];

		if (candCount > bestCount)
		{
			bestId = candId;
			bestCount = candCount;
			bestPriority = MaterialPriority(bestId);
#if VOXEL_MC_MAT_TIEBREAK_DEEP
			bestZ = BestSolidCornerZForMaterial(bestId, cpos, cd, cornerMats);
#endif
			continue;
		}

		if (candCount == bestCount && candId != bestId)
		{
#if VOXEL_MC_MAT_TIEBREAK_PRIORITY
			const uint candPriority = MaterialPriority(candId);
			if (candPriority > bestPriority)
			{
				bestId = candId;
				bestPriority = candPriority;
#if VOXEL_MC_MAT_TIEBREAK_DEEP
				bestZ = BestSolidCornerZForMaterial(bestId, cpos, cd, cornerMats);
#endif
				continue;
			}
#endif

#if VOXEL_MC_MAT_TIEBREAK_DEEP
			// Prefer deeper solid material on ties: lower solid-corner Z wins.
			const float candZ = BestSolidCornerZForMaterial(candId, cpos, cd, cornerMats);
			if (candZ < bestZ)
			{
				bestId = candId;
				bestZ = candZ;
				bestPriority = MaterialPriority(bestId);
				continue;
			}
#endif
		}
	}

	return bestId;
}

float3 VertexInterp(float iso, float3 p0, float3 p1, float d0, float d1)
{
	float denom = (d1 - d0);
	float t = (abs(denom) > 1e-8f) ? ((iso - d0) / denom) : 0.5f;
	t = clamp(t, 0.0f, 1.0f);
	return lerp(p0, p1, t);
}

uint ComputeCaseIndex(uint3 cell, out float3 cpos[8], out float cd[8])
{
	uint caseIndex = 0;
	[unroll] for (uint i = 0; i < 8; ++i)
	{
		const uint3 s = cell + (uint3)CornerOfs[i];
		const uint si = SampleIndex(s);
		cpos[i] = ChunkOriginWS + float3(s) * StepSizeWS;
		cd[i] = DensityField[si];

		caseIndex |= (cd[i] < IsoLevel) ? (1u << i) : 0u;
	}
	return caseIndex;
}

// ---- Kernel ----
// Matches your pass dispatch: Groups = ceil(N/8) in each axis
[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
	const uint x = DTid.x;
	const uint y = DTid.y;
	const uint z = DTid.z;

	if (x >= CellsPerAxis || y >= CellsPerAxis || z >= CellsPerAxis)
		return;

	const uint cellsPerSlice = CellsPerAxis * CellsPerAxis;
	const uint cellIndex = x + y * CellsPerAxis + z * cellsPerSlice;

	// Authoritative per-cell vertex count from Count pass (triCount*3)
	const uint vc = VertCountPerCell[cellIndex];
	if (vc == 0)
		return;

	// Base output index from scan (exclusive prefix sum)
	const uint base = VertOffsets[cellIndex];

	// Compute densities at corners
	uint3 cell = uint3(x, y, z);

	uint caseIndex = CaseIndexPerCell[cellIndex];
	if (caseIndex == 0 || caseIndex == 255) return;

	float3 cpos[8];
	float  cd[8];
	if (bUseCaseIndexPerCell == 0)
	{
		caseIndex = ComputeCaseIndex(cell, cpos, cd);
	}
	else
	{
		ComputeCaseIndex(cell, cpos, cd);
	}

	// For safety: if count/scatter disagree, refuse to emit.
	if (caseIndex == 0 || caseIndex == 255)
		return;

	const uint edgeMask = EdgeTable[caseIndex];
	if (edgeMask == 0)
		return;

	// Edge intersection positions
	float3 epos[12];
	[unroll] for (uint e = 0; e < 12; ++e)
	{
		if ((edgeMask & (1u << e)) != 0)
		{
			uint2 cc = EdgeCorners[e];
			epos[e] = VertexInterp(IsoLevel, cpos[cc.x], cpos[cc.y], cd[cc.x], cd[cc.y]);
		}
	}

	// Old vs new material selection
	const uint oldMaterialId = SelectCornerMaterial(cell, cd);

	uint cornerMaterials[8];
	[unroll] for (uint i = 0; i < 8; ++i)
	{
		const uint3 s = cell + (uint3)CornerOfs[i];
		cornerMaterials[i] = MaterialField[SampleIndex(s)];
	}

#if VOXEL_MC_MAT_TIEBREAK_DEEP
	const uint dominantMaterialId = ComputeDominantMaterial8(
		cornerMaterials[0], cornerMaterials[1], cornerMaterials[2], cornerMaterials[3],
		cornerMaterials[4], cornerMaterials[5], cornerMaterials[6], cornerMaterials[7],
		cpos, cd, cornerMaterials);
#else
	const uint dominantMaterialId = ComputeDominantMaterial8(
		cornerMaterials[0], cornerMaterials[1], cornerMaterials[2], cornerMaterials[3],
		cornerMaterials[4], cornerMaterials[5], cornerMaterials[6], cornerMaterials[7]);
#endif

#if VOXEL_MC_MATERIAL_MODE == 0
	const uint materialId = oldMaterialId;
	const uint color = MaterialIdToColor(materialId);
#elif VOXEL_MC_MATERIAL_MODE == 1
	const uint materialId = dominantMaterialId;
	const uint color = MaterialIdToColor(materialId);
#else
	const uint materialId = dominantMaterialId;
	const uint color = (oldMaterialId == dominantMaterialId)
		? PackColor(0, 200, 0, 255)
		: PackColor(220, 32, 32, 255);
#endif

	uint outV = 0;

	[unroll] for (uint t = 0; t < 16; t += 3)
	{
		const int e0 = TriTable[caseIndex][t + 0];
		if (e0 < 0) break;

		const int e1 = TriTable[caseIndex][t + 1];
		const int e2 = TriTable[caseIndex][t + 2];

		// Don't write past what Count said for this cell.
		if (outV + 3 > vc)
			break;

		// Convert to LOCAL space for PMC: subtract ChunkOriginWS
		const float3 p0L = epos[e0] - ChunkOriginWS;
		const float3 p1L = epos[e1] - ChunkOriginWS;
		const float3 p2L = epos[e2] - ChunkOriginWS;

		OutVertices[base + outV + 0] = float4(p0L, 1.0f);
		OutVertices[base + outV + 1] = float4(p1L, 1.0f);
		OutVertices[base + outV + 2] = float4(p2L, 1.0f);

		OutMaterialIds[base + outV + 0] = materialId;
		OutMaterialIds[base + outV + 1] = materialId;
		OutMaterialIds[base + outV + 2] = materialId;

		OutVertexColors[base + outV + 0] = color;
		OutVertexColors[base + outV + 1] = color;
		OutVertexColors[base + outV + 2] = color;

		outV += 3;
	}
}
