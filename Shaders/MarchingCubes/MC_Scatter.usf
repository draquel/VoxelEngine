#include "/Engine/Private/Common.ush"
#include "../Noise/VoxelNoiseParams.ush"
#include "MC_Tables.ush"

// If you have a matching .ush for noise params, you can include it too,
// but you don't need it for this plane test:
// #include "VoxelNoiseParams.ush"

// ---- Parameters injected by UE parameter struct ----
float3 ChunkOriginWS;
float  StepSizeWS;
uint   CellsPerAxis;
float  IsoLevel;
uint   ChunkSeed;
uint   Padding0;

// NOTE: Present in parameter struct; not used yet in this plane test.
// Must stay declared to match the C++ parameter layout.
// struct FVoxelNoiseParams
// {
// 	float3 WorldScale;
// 	float  HeightAmp;
//
// 	float  HeightFreq;
// 	float  HeightGain;
// 	uint   HeightOctaves;
//
// 	float  OverhangFreq;
// 	float  OverhangAmp;
// 	uint   OverhangOctaves;
//
// 	float  CaveFreq;
// 	float  CaveAmp;
// 	float  CaveThreshold;
// 	float  CaveSoftness;
//
// 	uint   Seed;
// 	float3 _Padding;
// };
ConstantBuffer<FVoxelNoiseParams> NoiseParams;

// Scan output (exclusive prefix sum of VertCountPerCell)
StructuredBuffer<uint> VertOffsets;     // N cells

// Output vertex buffer sized to TotalVerts (float4 per vertex here)
RWStructuredBuffer<float4> OutVertices; // TotalVerts entries

// Replace this with your real noise density
float SampleDensityWS(float3 Pws)
{
    // Example plane at Z=0:
    return Pws.z;
}

uint ComputeCaseIndex(float3 cellMinWS)
{
    uint caseIndex = 0;
    [unroll] for (uint i = 0; i < 8; ++i)
    {
        float3 p = cellMinWS + CornerOfs[i] * StepSizeWS;
        float d  = SampleDensityWS(p);
        caseIndex |= (d < IsoLevel) ? (1u << i) : 0u;
    }
    return caseIndex;
}

float3 VertexInterp(float iso, float3 p0, float3 p1, float d0, float d1)
{
    // Robust-ish interpolation
    float denom = (d1 - d0);
    float t = (abs(denom) > 1e-8f) ? ((iso - d0) / denom) : 0.5f;
    t = clamp(t, 0.0f, 1.0f);
    return lerp(p0, p1, t);
}

[numthreads(8,8,8)]
void Main(uint3 DTid : SV_DispatchThreadID)
{
    uint x = DTid.x, y = DTid.y, z = DTid.z;
    if (x >= CellsPerAxis || y >= CellsPerAxis || z >= CellsPerAxis) return;

    uint cellIndex = x + y * CellsPerAxis + z * CellsPerAxis * CellsPerAxis;
    float3 cellMinWS = ChunkOriginWS + float3(x,y,z) * StepSizeWS;

    // Case
    uint caseIndex = ComputeCaseIndex(cellMinWS);
    if (caseIndex == 0 || caseIndex == 255) return;

    uint edgeMask = EdgeTable[caseIndex];
    if (edgeMask == 0) return;

    // Corner positions + densities
    float3 cpos[8];
    float  cd[8];
    [unroll] for (uint i = 0; i < 8; ++i)
    {
        cpos[i] = cellMinWS + CornerOfs[i] * StepSizeWS;
        cd[i]   = SampleDensityWS(cpos[i]);
    }

    // Intersections on edges (up to 12)
    float3 epos[12];
    [unroll] for (uint e = 0; e < 12; ++e)
    {
        if ((edgeMask & (1u << e)) != 0)
        {
            uint2 cc = EdgeCorners[e];
            epos[e] = VertexInterp(IsoLevel, cpos[cc.x], cpos[cc.y], cd[cc.x], cd[cc.y]);
        }
    }

    // Base output index from scan
    uint base = VertOffsets[cellIndex];

    // Emit triangles from TriTable (3 edges per tri)
    // triTable row is 16 entries; -1 terminates.
    uint outV = 0;
    [unroll] for (uint t = 0; t < 16; t += 3)
    {
        int e0 = TriTable[caseIndex][t + 0];
        if (e0 < 0) break;

        int e1 = TriTable[caseIndex][t + 1];
        int e2 = TriTable[caseIndex][t + 2];

        // Write 3 vertices (float4 with w unused; you can pack material/id in w later)
        OutVertices[base + outV + 0] = float4(epos[e0], 1.0f);
        OutVertices[base + outV + 1] = float4(epos[e1], 1.0f);
        OutVertices[base + outV + 2] = float4(epos[e2], 1.0f);
        outV += 3;
    }

    // Optional: if you want safety, you can clamp writes using a count pass
    // but the table-driven loop is typically consistent with your count pass.
}
